{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wie",
  "identifier": "net.dlunch.wie",
  "build": {
    "frontendDist": "../wie-web/dist-native",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run start:native",
    "beforeBuildCommand": "npm run build:native"
  },
  "app": {
    "windows": [
      {
        "title": "wie",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "default",
          "description": "enables the default permissions",
          "windows": ["main"],
          "permissions": ["core:default"]
        }
      ],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 26
    },
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/Square310x310Logo.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
